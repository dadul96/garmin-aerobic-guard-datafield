#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"

python3 -m py_compile tools/*.py
python3 tools/test_logic.py
bash -n \
    tools/check \
    tools/garmin \
    tools/simulator \
    tools/test_garmin_state.sh \
    tools/testdata/fake_monkeyc.sh
./tools/test_garmin_state.sh

python3 - <<'PY'
import pathlib
import xml.etree.ElementTree as ET

for path in pathlib.Path("resources").rglob("*.xml"):
    ET.parse(path)
ET.parse("manifest.xml")
PY

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git diff --check
fi

./tools/garmin build
test -f bin/app.prg
./tools/garmin test
test -f bin/tests.prg
