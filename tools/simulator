#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"
device=edge840
tests=false
for argument in "$@"; do
    case "$argument" in
        --540|edge540) device=edge540 ;; --550|edge550) device=edge550 ;;
        --840|edge840) device=edge840 ;; --850|edge850) device=edge850 ;;
        --1040|edge1040) device=edge1040 ;; --1050|edge1050) device=edge1050 ;;
        --tests) tests=true ;;
        -h|--help) echo "Usage: $0 [--540|--550|--840|--850|--1040|--1050] [--tests]"; exit 0 ;;
        *) echo "Unknown argument: $argument" >&2; exit 2 ;;
    esac
done
if [[ "$tests" == true ]]; then GARMIN_DEVICE="$device" ./tools/garmin test; program=bin/tests.prg
else GARMIN_DEVICE="$device" ./tools/garmin build; program=bin/app.prg; fi
sdk_config="$HOME/.Garmin/ConnectIQ/current-sdk.cfg"
[[ -f "$sdk_config" ]] || { echo "Missing SDK configuration: $sdk_config" >&2; exit 1; }
CIQ_SDK_HOME="$(tr -d '\r\n' < "$sdk_config")"; export CIQ_SDK_HOME; export PATH="$CIQ_SDK_HOME/bin:$PATH"
[[ -n "${DISPLAY:-}" ]] || { echo "DISPLAY is not set; use the graphical VS Code container." >&2; exit 1; }
for command_name in connectiq monkeydo; do command -v "$command_name" >/dev/null || { echo "Missing Garmin command: $command_name" >&2; exit 1; }; done
[[ -f "$program" ]] || { echo "Missing program: $program" >&2; exit 1; }
nohup connectiq >/tmp/connectiq.log 2>&1 </dev/null &
simulator_pid=$!
for attempt in $(seq 1 30); do
    kill -0 "$simulator_pid" 2>/dev/null || { echo "Simulator exited; see /tmp/connectiq.log" >&2; exit 1; }
    if monkeydo "$program" "$device" >/tmp/monkeydo.log 2>&1; then echo "Loaded $program on $device."; exit 0; fi
    sleep 1
done
echo "Timed out loading $program; see /tmp/monkeydo.log" >&2; exit 1
